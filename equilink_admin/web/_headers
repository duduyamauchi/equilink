# Cabeçalhos de segurança servidos pela Cloudflare junto com o build web.
#
# A meta tags em `index.html` repete o essencial para hosts que ignoram este
# arquivo; aqui fica o que só o cabeçalho HTTP resolve (HSTS, frame-ancestors,
# permissões de recurso).

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Cross-Origin-Resource-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; media-src 'self' blob: https:; font-src 'self' data:; connect-src 'self' https://pub-8df2b57f664a42c0ad09120d9bf49cef.r2.dev; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests

# O service worker e o bootstrap não podem ser cacheados com HTML antigo.
/flutter_service_worker.js
  Cache-Control: no-store, max-age=0

/flutter_bootstrap.js
  Cache-Control: no-cache
